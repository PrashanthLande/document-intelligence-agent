# LLM backend: "transformers" runs the model in-process (no key needed);
# "openai_compatible" calls a Chat Completions server.
GENERATOR__BACKEND=transformers
GENERATOR__MODEL=Qwen/Qwen3-1.7B

# openai_compatible only. Leave BASE_URL empty for api.openai.com, or point
# it at another server, e.g. https://api.groq.com/openai/v1 or
# http://localhost:8000/v1 (vLLM). Local servers usually need no key.
# GENERATOR__BASE_URL=
# GENERATOR__API_KEY=

# Application
LOG_LEVEL=INFO